APP_NAME=PropertyHub
APP_ENV=development
APP_VERSION=1.0.0

# JWT
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# MongoDB
MONGODB_URL=mongodb://admin:NatVoice!123@localhost:27017/propertyhub?authSource=admin
MONGODB_DB_NAME=propertyhub

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@propertyhub.app

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Redis (optional)
REDIS_URL=
