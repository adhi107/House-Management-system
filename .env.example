# =====================================================
# PropertyHub — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================

# Application
APP_ENV=development
APP_NAME=PropertyHub
APP_VERSION=1.0.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8026

# Security
SECRET_KEY=CHANGE-ME-USE-openssl-rand-hex-32
JWT_SECRET_KEY=CHANGE-ME-ANOTHER-LONG-RANDOM-STRING
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=propertyhub

# Redis (optional)
REDIS_URL=redis://localhost:6379

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=PropertyHub <noreply@propertyhub.app>

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=PropertyHub
